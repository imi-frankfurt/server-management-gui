# Docker bind for frontend container on host
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000

# Nuxt server-side backend target (inside container)
# Local VM default: backend on Docker host port 5000
NUXT_API_BASE_URL=http://host.docker.internal:5000

# Keep empty to force browser -> same origin -> Nuxt BFF routes
NUXT_PUBLIC_API_BASE_URL=
